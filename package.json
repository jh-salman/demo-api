{
  "name": "demo-api",
  "version": "1.0.0",
  "private": true,
  "description": "Demo REST API — Express, TypeScript, Prisma, PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/modules/ghost-notes/prompts dist/modules/ghost-notes/",
    "start": "node dist/server.js",
    "worker:ghost-notes": "tsx src/workers/ghost-notes.entry.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reconcile-migrations": "tsx scripts/reconcile-prisma-migrations.ts",
    "db:studio": "prisma studio",
    "db:seed-catalog": "tsx scripts/seed-catalog.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.23",
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.3.3",
    "better-auth": "^1.6.23",
    "bullmq": "^5.80.9",
    "cloudinary": "^2.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "kill-port": "^2.0.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3",
    "openai": "^6.44.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
