# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── Postgres (docker-compose service: postgres) ─────────────────────────────
POSTGRES_DB=salonx_demo
POSTGRES_USER=salonx
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://salonx:CHANGE_ME_STRONG_PASSWORD@postgres:5432/salonx_demo?schema=public
# PRISMA_LOG_QUERIES=true

# ─── Redis TCP (docker-compose service: redis) — Socket.IO + BullMQ + cache ─
REDIS_URL=redis://redis:6379

# Optional Upstash REST (usually not needed if REDIS_URL is set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Catalog cache TTL (seconds)
CLIENTS_CACHE_TTL_SECONDS=60

# ─── Public URLs / Auth (api.salonx.com) ─────────────────────────────────────
BETTER_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
BETTER_AUTH_URL=https://api.salonx.com
DEMO_API_PUBLIC_URL=https://api.salonx.com
PUBLIC_SITE_URL=https://api.salonx.com
# NEXT_PUBLIC_SITE_URL=
# RENDER_EXTERNAL_URL=

WEB_ORIGIN=https://demo.salonx.com
APP_PUBLIC_ORIGIN=https://demo.salonx.com
CORS_ORIGINS=https://demo.salonx.com,https://admin.salonx.com,https://www.salonx.com,https://salonx.com

COOKIE_SAMESITE=none
COOKIE_DOMAIN=.salonx.com

AUTH_OTP_MOCK=false
AUTH_MOCK_OTP_CODE=123456

# ─── OpenAI (RAMP + Ghost Notes) ─────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Ghost Notes worker ──────────────────────────────────────────────────────
GHOST_NOTES_ENABLED=1
GHOST_NOTES_INLINE_WORKER=0
GHOST_NOTES_MODEL=gpt-4o-mini
GHOST_NOTES_WORKER_CONCURRENCY=5

# ─── Cloudinary uploads ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Vercel Blob (if not using Cloudinary)
BLOB_READ_WRITE_TOKEN=

# ─── SMS (sent.dm) ───────────────────────────────────────────────────────────
SENT_DM_API_KEY=
SENT_DM_CHANNEL=
SENT_DM_SANDBOX=false
SENT_DM_OTP_PARAM=
SENT_DM_OTP_TEMPLATE_ID=
SENT_DM_OTP_TEMPLATE_NAME=

# ─── Invite email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INVITE_FROM_EMAIL=

# ─── Optional R2 backup scripts ──────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_BACKUP_PREFIX=demo-api/backups/
